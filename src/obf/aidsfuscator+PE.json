{
	"in": "TEMP.jar",
	"out": "TEMP_obf.jar",
	"libs": "../../src/obf/lib",
	"dictionary": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
	"computeFrames": true,
	"watermark": "",
	"aggressiveOverload": true,
	"exclusionPresets": [
		"api",
		"mc-fabric"
	],
	"transformers": {
		"trim": {
			"enabled": false,
			"classes": false,
			"fields": false,
			"methods": false
		},
		"renameFields": {
			"enabled": false,
			"preserveRecordNames": false,
			"keepSerializableNames": false,
			"prefix": "",
			"shuffle": false
		},
		"renameMethods": {
			"enabled": false,
			"prefix": "",
			"shuffle": false
		},
		"renameClasses": {
			"enabled": false,
			"prefix": "",
			"mixinPrefix": "",
			"renameSourceFile": false,
			"randomize": false
		},
		"localNames": {
			"enabled": true
		},
		"lineNumbers": {
			"enabled": true,
			"remove": true
		},
		"methodSalting": {
			"enabled": false
		},
		"classSalting": {
			"enabled": false,
			"unifyAccess": false
		},
		"fixConstants": {
			"enabled": true
		},
		"integerEncrypt": {
			"enabled": true,
			"excludeLowSignificant": true
		},
		"encryptStrings": {
			"enabled": true,
			"translateConcat": true,
			"minLength": 1,
			"useDefault": false,
			"usePoly1": false,
			"usePoly2": true
		},
		"flowInts": {
			"enabled": true,
			"obfuscateLongs": true,
			"separateBlocks": true,
			"confuseFlow": true
		},
		"controlFlowFlatten": {
			"enabled": false,
			"obfuscateValues": false
		},
		"controlFlowShuffle": {
			"enabled": false
		},
		"cleanDeadCode": {
			"enabled": false
		},
		"referenceObfuscate": {
			"enabled": false
		},
		"hashIntegrity": {
			"enabled": false
		}
	}
}
