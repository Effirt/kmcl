{
	"in": "KinastMinecraftLauncher.jar",
	"out": "KinastMinecraftLauncher_obf.jar",
	"libs": "../../src/obf/lib",
	"dictionary": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
	"computeFrames": true,
	"watermark": "",
	"aggressiveOverload": true,
	"exclusionPresets": [
		"api",
		"mc-fabric"
	],
	"transformers": {
		"trim": {
			"enabled": false,
			"classes": true,
			"fields": true,
			"methods": true
		},
		"renameFields": {
			"enabled": true,
			"preserveRecordNames": true,
			"keepSerializableNames": false,
			"prefix": "f",
			"shuffle": true
		},
		"renameMethods": {
			"enabled": true,
			"prefix": "m",
			"shuffle": true
		},
		"renameClasses": {
			"enabled": true,
			"prefix": "c",
			"mixinPrefix": "c",
			"renameSourceFile": true,
			"randomize": true
		},
		"localNames": {
			"enabled": true
		},
		"lineNumbers": {
			"enabled": true,
			"remove": true
		},
		"methodSalting": {
			"enabled": true
		},
		"classSalting": {
			"enabled": true,
			"unifyAccess": true
		},
		"fixConstants": {
			"enabled": true
		},
		"integerEncrypt": {
			"enabled": true,
			"excludeLowSignificant": true
		},
		"encryptStrings": {
			"enabled": true,
			"translateConcat": true,
			"minLength": 1,
			"useDefault": false,
			"usePoly1": false,
			"usePoly2": true
		},
		"flowInts": {
			"enabled": true,
			"obfuscateLongs": true,
			"separateBlocks": true,
			"confuseFlow": true
		},
		"controlFlowFlatten": {
			"enabled": true,
			"obfuscateValues": true
		},
		"controlFlowShuffle": {
			"enabled": true
		},
		"cleanDeadCode": {
			"enabled": false
		},
		"referenceObfuscate": {
			"enabled": true
		},
		"hashIntegrity": {
			"enabled": true
		}
	}
}
